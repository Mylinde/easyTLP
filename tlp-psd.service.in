# TLP Power Saver Daemon
# Automatically switches between profiles based on workload lag detection
#
# Copyright (c) 2026 Mario Herrmann <marioherrmann at posteo.de> and others.
# SPDX-License-Identifier: GPL-2.0-or-later

[Unit]
Description=TLP Power Saver Daemon
After=tlp.service
PartOf=tlp.service

[Service]
Type=simple
ExecStart=/usr/bin/tlp-psd run
ExecStop=/usr/bin/tlp-psd stop
Restart=on-failure
RestartSec=5
KillMode=mixed

StandardOutput=journal
StandardError=journal

NoNewPrivileges=yes
ProtectHome=yes
ReadWritePaths=/run/tlp /tmp /proc /sys /sys/fs/cgroup
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=no
CPUSchedulingPolicy=fifo
CPUSchedulingPriority=50
Nice=-10
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_NET_ADMIN
Delegate=cpuset io
